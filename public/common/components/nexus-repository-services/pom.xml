    <dependency>
      <groupId>org.sonatype.nexus.common.components</groupId>
      <artifactId>nexus-datastore-api</artifactId>
    </dependency>

    <dependency>
      <groupId>org.sonatype.nexus.common.components</groupId>
      <artifactId>nexus-httpclient</artifactId>
