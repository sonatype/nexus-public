    <artifactId>nexus-common-components-formats-parent</artifactId>
    <version>3.90.2-06</version>
  </parent>


  <artifactId>nexus-repository-apt</artifactId>
  <name>${project.groupId}:${project.artifactId}</name>

  <dependencies>
    <dependency>
      <groupId>org.sonatype.nexus.common.components</groupId>
      <artifactId>nexus-plugin-api</artifactId>
    </dependency>

    <dependency>
      <groupId>org.sonatype.nexus.common.components</groupId>
      <artifactId>nexus-common</artifactId>
    </dependency>

    <dependency>
      <groupId>org.sonatype.nexus.common.components</groupId>
      <artifactId>nexus-repository-content</artifactId>
      <optional>true</optional>
    </dependency>

    <dependency>
      <groupId>org.sonatype.nexus.common.components</groupId>
      <artifactId>nexus-repository-content</artifactId>
      <version>${project.version}</version>
      <classifier>tests</classifier>
      <optional>true</optional>
      <scope>test</scope>
    </dependency>

    <dependency>
      <groupId>org.sonatype.nexus.common.components</groupId>
      <artifactId>nexus-blobstore-tasks</artifactId>
    </dependency>

    <dependency>
      <groupId>org.sonatype.nexus.common.components</groupId>
      <artifactId>nexus-testsupport</artifactId>
      <scope>test</scope>
    </dependency>

    <dependency>
      <groupId>org.assertj</groupId>
      <artifactId>assertj-core</artifactId>
      <scope>test</scope>
    </dependency>

    <dependency>
      <groupId>org.apache.commons</groupId>
      <artifactId>commons-compress</artifactId>
    </dependency>

    <dependency>
      <groupId>org.tukaani</groupId>
      <artifactId>xz</artifactId>
    </dependency>

    <!-- commons-compress dependency for zstd support -->
