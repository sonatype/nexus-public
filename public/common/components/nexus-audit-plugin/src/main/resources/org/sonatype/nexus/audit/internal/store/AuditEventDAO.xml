<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="org.sonatype.nexus.audit.internal.store.AuditEventDAO">

  <insert id="createSchema" databaseId="PostgreSQL">
    CREATE TABLE IF NOT EXISTS audit_events (
      id BIGSERIAL PRIMARY KEY,
      domain VARCHAR(255) NOT NULL,
      type VARCHAR(255) NOT NULL,
      context VARCHAR(500),
      timestamp TIMESTAMP WITH TIME ZONE NOT NULL,
      initiator VARCHAR(255),
      node_id VARCHAR(100),
      attributes JSONB
    );
  </insert>

  <insert id="createSchema" databaseId="H2">
    CREATE TABLE IF NOT EXISTS audit_events (
      id BIGINT AUTO_INCREMENT PRIMARY KEY,
      domain VARCHAR(255) NOT NULL,
      type VARCHAR(255) NOT NULL,
      context VARCHAR(500),
      timestamp TIMESTAMP WITH TIME ZONE NOT NULL,
      initiator VARCHAR(255),
      node_id VARCHAR(100),
      attributes JSON
    );
  </insert>

  <resultMap id="auditEventResult" type="org.sonatype.nexus.audit.internal.store.AuditEventData">
    <id property="id" column="id"/>
    <result property="domain" column="domain"/>
    <result property="type" column="type"/>
    <result property="context" column="context"/>
    <result property="timestamp" column="timestamp"/>
    <result property="initiator" column="initiator"/>
    <result property="nodeId" column="node_id"/>
    <result property="attributes" column="attributes" typeHandler="org.sonatype.nexus.datastore.mybatis.handlers.AttributesTypeHandler"/>
  </resultMap>

  <!--
    Match every row whose context "belongs to" repositoryName. context holds either the bare
    repo name (repo-level events) or "<repo>:<suffix>" (component/asset events).
  -->
  <sql id="repositoryNameCondition">
    <if test="repositoryName != null">
      AND (context = #{repositoryName} OR context LIKE #{repositoryName} || ':%')
    </if>
  </sql>

  <sql id="whereClause">
    <where>
      <if test="domain != null">
        AND domain = #{domain}
      </if>
      <if test="type != null">
        AND type = #{type}
      </if>
      <if test="initiator != null">
        AND initiator = #{initiator}
      </if>
      <if test="startDate != null">
        AND timestamp &gt;= #{startDate}
      </if>
      <if test="endDate != null">
        AND timestamp &lt;= #{endDate}
      </if>
      <include refid="repositoryNameCondition"/>
    </where>
  </sql>

  <select id="findAll" resultMap="auditEventResult">
    SELECT id, domain, type, context, timestamp, initiator, node_id, attributes
    FROM audit_events
    <include refid="whereClause"/>
    ORDER BY timestamp DESC
    LIMIT #{limit} OFFSET #{offset}
  </select>

  <select id="count" resultType="int">
    SELECT COUNT(*)
    FROM audit_events
    <include refid="whereClause"/>
  </select>

  <insert id="insert" parameterType="org.sonatype.nexus.audit.internal.store.AuditEventData" databaseId="PostgreSQL">
    INSERT INTO audit_events (domain, type, context, timestamp, initiator, node_id, attributes)
    VALUES (#{domain}, #{type}, #{context}, #{timestamp}, #{initiator}, #{nodeId},
            #{attributes, typeHandler=org.sonatype.nexus.datastore.mybatis.handlers.AttributesTypeHandler}::jsonb)
  </insert>

  <insert id="insert" parameterType="org.sonatype.nexus.audit.internal.store.AuditEventData" databaseId="H2">
    INSERT INTO audit_events (domain, type, context, timestamp, initiator, node_id, attributes)
    VALUES (#{domain}, #{type}, #{context}, #{timestamp}, #{initiator}, #{nodeId},
            #{attributes, typeHandler=org.sonatype.nexus.datastore.mybatis.handlers.AttributesTypeHandler})
  </insert>

  <sql id="whereClauseMultipleDomains">
    <where>
      <if test="domains != null and domains.size() > 0">
        AND domain IN
        <foreach item="d" collection="domains" open="(" separator="," close=")">
          #{d}
        </foreach>
      </if>
      <if test="type != null">
        AND type = #{type}
      </if>
      <if test="initiator != null">
        AND initiator = #{initiator}
      </if>
      <if test="startDate != null">
        AND timestamp &gt;= #{startDate}
      </if>
      <if test="endDate != null">
        AND timestamp &lt;= #{endDate}
      </if>
      <include refid="repositoryNameCondition"/>
    </where>
  </sql>

  <select id="findByDomains" resultMap="auditEventResult">
    SELECT id, domain, type, context, timestamp, initiator, node_id, attributes
    FROM audit_events
    <include refid="whereClauseMultipleDomains"/>
    ORDER BY timestamp DESC
    LIMIT #{limit} OFFSET #{offset}
  </select>

  <select id="countByDomains" resultType="int">
    SELECT COUNT(*)
    FROM audit_events
    <include refid="whereClauseMultipleDomains"/>
  </select>

  <!-- PostgreSQL does not allow LIMIT directly on DELETE; use a subquery. -->
  <delete id="deleteOlderThan" databaseId="PostgreSQL">
    DELETE FROM audit_events
    WHERE id IN (
      SELECT id FROM audit_events
      WHERE timestamp &lt; #{cutoff}
      ORDER BY timestamp ASC
      LIMIT #{batchSize}
    )
  </delete>

  <!-- H2 supports LIMIT directly on DELETE. -->
  <delete id="deleteOlderThan" databaseId="H2">
    DELETE FROM audit_events
    WHERE timestamp &lt; #{cutoff}
    LIMIT #{batchSize}
  </delete>

</mapper>
