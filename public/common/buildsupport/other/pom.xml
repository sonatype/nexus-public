      </dependency>

      <dependency>
        <groupId>com.google.code.findbugs</groupId>
        <artifactId>jsr305</artifactId>
        <version>3.0.2</version>
      </dependency>

      <!-- NEXUS-46395: dropped vestigial javax.annotation-api / javax.enterprise:cdi-api /
           javax.inject:javax.inject / javax.interceptor-api version pins. None of these
           coordinates appear on any compile or test classpath after the EE10 migration, and
           the distribution-level enforcer bans (javax.{servlet,inject,ws.rs,validation,
           enterprise,el,interceptor,transaction,xml.bind}:*) prevent transitive
           reintroduction. -->

      <dependency>
        <groupId>jakarta.inject</groupId>
        <artifactId>jakarta.inject-api</artifactId>
        <version>2.0.1</version>
      </dependency>

      <dependency>
        <groupId>com.google.errorprone</groupId>
        <artifactId>error_prone_annotations</artifactId>
        <version>2.21.1</version>
      </dependency>

      <dependency>
        <groupId>org.apache.velocity</groupId>
        <artifactId>velocity-engine-core</artifactId>
        <version>2.4</version>
      </dependency>

      <dependency>
        <groupId>joda-time</groupId>
        <artifactId>joda-time</artifactId>
        <version>2.10.14</version>
      </dependency>

      <dependency>
        <groupId>org.hdrhistogram</groupId>
        <artifactId>HdrHistogram</artifactId>
        <version>2.2.1</version>
      </dependency>

      <dependency>
        <groupId>org.apache.tika</groupId>
        <artifactId>tika-core</artifactId>
        <version>3.2.2</version>
      </dependency>

      <dependency>
        <groupId>org.codehaus.mojo</groupId>
        <artifactId>animal-sniffer-annotations</artifactId>
        <version>1.24</version>
      </dependency>

      <dependency>
        <groupId>eu.bitwalker</groupId>
        <artifactId>UserAgentUtils</artifactId>
        <version>1.21</version>
      </dependency>

      <!-- NEXUS-46395: Jakarta Validation 3.0.x for Jakarta EE 10 / RESTEasy 7. The 2.0.x
           series is the Jakarta EE 8 line and is incompatible with RESTEasy 7's
           ResteasyViolationException. -->
      <dependency>
        <groupId>jakarta.validation</groupId>
        <artifactId>jakarta.validation-api</artifactId>
        <version>3.0.2</version>
      </dependency>

      <!-- NEXUS-46395: org.glassfish:jakarta.el:3.0.4 is misnamed — despite its
           artifactId, the classes inside are still in the javax.el.* package. It
           does NOT provide jakarta.el.ELManager, which Hibernate Validator 8 needs at
           runtime. The correct Jakarta EL 5.0 reference implementation is
           org.glassfish.expressly:expressly (the renamed/relocated Eclipse Expressly
           project), which depends on jakarta.el:jakarta.el-api:5.0.x transitively.
           Without this, *every* test that calls Validation.buildDefaultValidatorFactory()
           throws HV000183 "Unable to initialize 'jakarta.el.ExpressionFactory'". -->
      <dependency>
        <groupId>org.glassfish.expressly</groupId>
        <artifactId>expressly</artifactId>
        <version>5.0.0</version>
      </dependency>

      <!-- NEXUS-46395: Hibernate Validator 8.x is the Jakarta Validation 3.0 implementation
           (Hibernate Validator 6.x targets Jakarta Validation 2.0). -->
      <dependency>
        <groupId>org.hibernate.validator</groupId>
        <artifactId>hibernate-validator</artifactId>
        <version>8.0.2.Final</version>
      </dependency>

      <dependency>
        <groupId>org.quartz-scheduler</groupId>
        <artifactId>quartz</artifactId>
        <version>2.3.2</version>
        <exclusions>
          <exclusion>
            <groupId>com.mchange</groupId>
            <artifactId>c3p0</artifactId>
          </exclusion>
          <exclusion>
            <groupId>com.mchange</groupId>
            <artifactId>mchange-commons-java</artifactId>
          </exclusion>
          <exclusion>
            <groupId>com.zaxxer</groupId>
            <artifactId>HikariCP-java6</artifactId>
          </exclusion>
        </exclusions>
      </dependency>

      <dependency>
        <groupId>com.vividsolutions</groupId>
        <artifactId>jts</artifactId>
        <version>1.13</version>
      </dependency>

      <!-- javax.transaction-api retained for nexus-repository-services test scope only;
           the distribution-level enforcer ban prevents this from leaking into runtime. -->
      <dependency>
        <groupId>javax.transaction</groupId>
        <artifactId>javax.transaction-api</artifactId>
        <version>1.2</version>
      </dependency>

      <dependency>
        <groupId>com.thoughtworks.paranamer</groupId>
        <artifactId>paranamer</artifactId>
        <version>2.8</version>
      </dependency>

      <dependency>
        <groupId>org.codehaus.plexus</groupId>
        <artifactId>plexus-interpolation</artifactId>
        <version>1.27</version>
      </dependency>

      <dependency>
        <groupId>org.codehaus.plexus</groupId>
        <artifactId>plexus-utils</artifactId>
        <version>4.0.3</version>
      </dependency>

      <dependency>
        <groupId>org.codehaus.plexus</groupId>
        <artifactId>plexus-xml</artifactId>
        <version>4.1.1</version>
      </dependency>

      <dependency>
        <groupId>javax.cache</groupId>
        <artifactId>cache-api</artifactId>
        <version>1.1.1</version>
      </dependency>

      <!-- NEXUS-46395: ehcache 3.9.x is compiled against javax.xml.bind.*, which was
           removed from the JDK in Java 11 and is not part of Jakarta EE 10. ehcache
           3.10+ ships a separate "jakarta" classifier whose XML config code uses
           jakarta.xml.bind.*. Without the classifier the bytecode still references
           javax.xml.bind.ValidationEventHandler, which fails to load at runtime
           (NoClassDefFoundError) on Java 25. -->
      <dependency>
        <groupId>org.ehcache</groupId>
        <artifactId>ehcache</artifactId>
        <version>3.10.8</version>
        <classifier>jakarta</classifier>
      </dependency>

      <dependency>
        <groupId>com.squareup</groupId>
        <artifactId>tape</artifactId>
        <version>1.2.3</version>
      </dependency>

      <dependency>
        <groupId>org.freemarker</groupId>
        <artifactId>freemarker</artifactId>
        <version>2.3.32</version>
      </dependency>

      <dependency>
        <groupId>org.mozilla</groupId>
        <artifactId>rhino</artifactId>
        <version>1.7.15.1</version>
      </dependency>

      <dependency>
        <groupId>com.atlassian.crowd.client</groupId>
        <artifactId>atlassian-crowd-rest-client</artifactId>
        <version>1.1</version>
        <exclusions>
          <!-- We provide an http client 4 implementation -->
          <exclusion>
            <groupId>commons-httpclient</groupId>
            <artifactId>commons-httpclient</artifactId>
          </exclusion>
          <!-- Exclude dependencies which are provided by NX core. -->
          <exclusion>
            <groupId>commons-lang</groupId>
            <artifactId>commons-lang</artifactId>
          </exclusion>
          <exclusion>
            <groupId>commons-codec</groupId>
            <artifactId>commons-codec</artifactId>
          </exclusion>
        </exclusions>
      </dependency>

      <dependency>
        <groupId>org.redline-rpm</groupId>
        <artifactId>redline</artifactId>
        <version>1.2.5</version>
        <exclusions>
          <exclusion>
            <groupId>org.apache.ant</groupId>
            <artifactId>ant</artifactId>
          </exclusion>
          <exclusion>
            <groupId>org.bouncycastle</groupId>
            <artifactId>bcpg-jdk15on</artifactId>
          </exclusion>
        </exclusions>
      </dependency>

      <dependency>
        <groupId>com.google.jimfs</groupId>
        <artifactId>jimfs</artifactId>
        <version>1.1</version>
      </dependency>

      <!--
        NEXUS-54004: Upgrade netty-bom to 4.2.16.Final to resolve CVE-2026-56819
        (netty-codec-http2 memory leak in the HTTP/2 decompressor - CWE-401,
        CVSS 7.5, GHSA-93wv-jw9v-4972).
        NEXUS-53122: Upgrade netty-bom to 4.2.15.Final to resolve CVE-2026-42587
        (codec-http/http2 decompression limit bypass - CVSS 8.7). The earlier
        4.2.14.Final upgrade addressed the following CVEs but not 42587:
        - CVE-2026-42577 (epoll transport DoS - CVSS 8.7)
        - CVE-2026-42578 (handler-proxy HTTP header injection - CVSS 7.5)
        - CVE-2026-42579 (codec-dns domain name validation - CVSS 7.5)
        - CVE-2026-42580, 42581, 42584, 42585, 41417 (codec-http request smuggling - CVSS 5.3-8.7)
        - CVE-2026-42583 (codec-compression memory allocation DoS - CVSS 7.5)
      -->
      <dependency>
        <groupId>io.netty</groupId>
        <artifactId>netty-bom</artifactId>
        <version>4.2.16.Final</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>

      <dependency>
        <groupId>io.projectreactor</groupId>
        <artifactId>reactor-bom</artifactId>
        <version>2025.0.6</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>

      <dependency>
