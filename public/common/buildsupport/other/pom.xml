      <!--
        Security fix: azure-storage-blob 12.31.2 depends on azure-core-http-netty 1.16.0,
        which includes vulnerable netty-codec and netty-codec-http (version 4.1.124.Final).
        Overriding to 1.16.1 to address these vulnerabilities.

        TODO: Remove this override after azure-storage-blob updates its dependency to 1.16.1 or higher.
              Check for updates when upgrading azure-storage-blob.version above.
      -->
      <dependency>
        <groupId>com.azure</groupId>
        <artifactId>azure-core-http-netty</artifactId>
        <version>1.16.2</version>
      </dependency>

      <!-- NEXUS-46395 + NEXUS-50522 (CVE-2025-7962): pin com.sun.mail:jakarta.mail to the
           patched 2.0.2 release. The EE-9-era com.sun.mail coordinates are what
           commons-email2-jakarta:2.0.0-M1 references directly in its bytecode, so we cannot
           swap to the post-EE-9 successor org.eclipse.angus:jakarta.mail without forking
           commons-email. Verified that nothing on the dep tree pulls in
           org.eclipse.angus:jakarta.mail, so an Angus pin would be dead code. -->
      <dependency>
        <groupId>com.sun.mail</groupId>
        <artifactId>jakarta.mail</artifactId>
        <version>2.0.2</version>
      </dependency>

      <dependency>
        <groupId>org.sonatype.goodies</groupId>
        <artifactId>package-url-java</artifactId>
        <version>1.1.1</version>
      </dependency>

      <dependency>
        <groupId>io.grpc</groupId>
        <artifactId>grpc-bom</artifactId>
        <version>1.82.0</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>

      <dependency>
        <groupId>dev.sigstore</groupId>
        <artifactId>sigstore-java</artifactId>
        <version>2.2.0</version>
        <!--
          Consider updating grpc-bom when updating the version

          Remove grpc-bom if removing this dependency
         -->
        <exclusions>
          <exclusion>
            <groupId>io.grpc</groupId>
            <artifactId>grpc-netty-shaded</artifactId>
          </exclusion>
        </exclusions>
      </dependency>
    </dependencies>
  </dependencyManagement>

