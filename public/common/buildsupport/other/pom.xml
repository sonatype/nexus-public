<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/maven-v4_0_0.xsd">

  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>org.sonatype.nexus.common.buildsupport</groupId>
    <artifactId>nexus-common-buildsupport-parent</artifactId>
    <version>3.95.0-07</version>
  </parent>

  <artifactId>nexus-common-buildsupport-other</artifactId>
  <name>${project.groupId}:${project.artifactId}</name>
  <packaging>pom</packaging>

  <properties>
    <!--
       Updates to AWS or Azure SDKs should also examine their expected netty dependencies, and potentially adjust
       the netty BOM import
    -->
    <aws-java-sdk.version>2.33.5</aws-java-sdk.version>
    <woodstox-core.version>6.7.0</woodstox-core.version>
    <!--
      IMPORTANT: When upgrading azure-storage-blob.version check if the security override
      of azure-core-http-netty can be removed from dependencyManagement below.
     -->
    <azure-storage-blob.version>12.31.2</azure-storage-blob.version>
    <azure-identity.version>1.18.0</azure-identity.version>
    <azure-json.version>1.5.0</azure-json.version>
    <!-- NEXUS-46395: jakarta-mail.version is now unused. The runtime Mail implementation is
         com.sun.mail:jakarta.mail:2.0.2 (pulled in by commons-email2-jakarta), pinned
         explicitly below to address NEXUS-50522 (CVE-2025-7962). The Eclipse Angus pin
         that previously consumed this version was removed because nothing on the dep
         tree pulled in org.eclipse.angus:jakarta.mail - leaving the pin in place would
         have been dead code. Property kept defined-but-unused for one more release in
         case downstream developer scripts grep for it. -->
    <jakarta-mail.version>2.0.3</jakarta-mail.version>
  </properties>

  <dependencyManagement>
