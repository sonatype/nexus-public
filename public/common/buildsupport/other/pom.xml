      </dependency>

      <!-- NEXUS-46395: Jakarta Validation 3.0.x for Jakarta EE 10 / RESTEasy 7. The 2.0.x
           series is the Jakarta EE 8 line and is incompatible with RESTEasy 7's
           ResteasyViolationException. -->
      <dependency>
        <groupId>jakarta.validation</groupId>
        <artifactId>jakarta.validation-api</artifactId>
        <version>3.0.2</version>
      </dependency>

      <!-- NEXUS-46395: org.glassfish:jakarta.el:3.0.4 is misnamed — despite its
           artifactId, the classes inside are still in the javax.el.* package. It
           does NOT provide jakarta.el.ELManager, which Hibernate Validator 8 needs at
           runtime. The correct Jakarta EL 5.0 reference implementation is
           org.glassfish.expressly:expressly (the renamed/relocated Eclipse Expressly
           project), which depends on jakarta.el:jakarta.el-api:5.0.x transitively.
           Without this, *every* test that calls Validation.buildDefaultValidatorFactory()
           throws HV000183 "Unable to initialize 'jakarta.el.ExpressionFactory'". -->
      <dependency>
        <groupId>org.glassfish.expressly</groupId>
        <artifactId>expressly</artifactId>
        <version>5.0.0</version>
      </dependency>

      <!-- NEXUS-46395: Hibernate Validator 8.x is the Jakarta Validation 3.0 implementation
           (Hibernate Validator 6.x targets Jakarta Validation 2.0). -->
      <dependency>
        <groupId>org.hibernate.validator</groupId>
        <artifactId>hibernate-validator</artifactId>
        <version>8.0.2.Final</version>
      </dependency>

      <dependency>
        <groupId>org.quartz-scheduler</groupId>
        <artifactId>quartz</artifactId>
        <version>2.3.2</version>
        <exclusions>
          <exclusion>
            <groupId>com.mchange</groupId>
            <artifactId>c3p0</artifactId>
          </exclusion>
          <exclusion>
            <groupId>com.mchange</groupId>
            <artifactId>mchange-commons-java</artifactId>
          </exclusion>
          <exclusion>
            <groupId>com.zaxxer</groupId>
            <artifactId>HikariCP-java6</artifactId>
          </exclusion>
        </exclusions>
      </dependency>

      <!-- javax.transaction-api retained for nexus-repository-services test scope only;
           the distribution-level enforcer ban prevents this from leaking into runtime. -->
      <dependency>
        <groupId>javax.transaction</groupId>
        <artifactId>javax.transaction-api</artifactId>
        <version>1.2</version>
      </dependency>

      <dependency>
        <groupId>com.thoughtworks.paranamer</groupId>
        <artifactId>paranamer</artifactId>
        <version>2.8</version>
      </dependency>

      <dependency>
        <groupId>org.codehaus.plexus</groupId>
        <artifactId>plexus-interpolation</artifactId>
        <version>1.27</version>
      </dependency>

      <dependency>
        <groupId>org.codehaus.plexus</groupId>
        <artifactId>plexus-utils</artifactId>
        <version>4.0.3</version>
      </dependency>

      <dependency>
        <groupId>org.codehaus.plexus</groupId>
        <artifactId>plexus-xml</artifactId>
        <version>4.1.1</version>
      </dependency>

      <dependency>
        <groupId>javax.cache</groupId>
        <artifactId>cache-api</artifactId>
        <version>1.1.1</version>
      </dependency>

      <!-- NEXUS-46395: ehcache 3.9.x is compiled against javax.xml.bind.*, which was
           removed from the JDK in Java 11 and is not part of Jakarta EE 10. ehcache
           3.10+ ships a separate "jakarta" classifier whose XML config code uses
           jakarta.xml.bind.*. Without the classifier the bytecode still references
           javax.xml.bind.ValidationEventHandler, which fails to load at runtime
           (NoClassDefFoundError) on Java 25. -->
      <dependency>
        <groupId>org.ehcache</groupId>
        <artifactId>ehcache</artifactId>
        <version>3.10.8</version>
        <classifier>jakarta</classifier>
      </dependency>

      <dependency>
        <groupId>com.squareup</groupId>
        <artifactId>tape</artifactId>
        <version>1.2.3</version>
      </dependency>

      <dependency>
        <groupId>org.mozilla</groupId>
        <artifactId>rhino</artifactId>
        <version>1.7.15.1</version>
      </dependency>

      <!--
        NEXUS-55072: Upgrade netty-bom to 4.2.18.Final to resolve the Security-High
        advisories flagged against 4.2.17.Final across all four IQ applications:
        - sonatype-2026-008023 (CVSS 8.2), -008020 and -008024 (CVSS 7.5) in codec-http2
        - sonatype-2026-008016, -008017, -008019, -008020, -008021, -008022 (CVSS 7.5) in codec-http3
        - sonatype-2026-008031 (CVSS 7.5) in codec-classes-quic
        Sonatype Guide reports 4.2.18.Final as policy compliant with no known
        vulnerabilities; it also clears the Security-Medium findings in codec-http.
        NEXUS-54504: Upgrade netty-bom to 4.2.17.Final to resolve the netty-handler
        hostname verification bypass on the OpenSSL client path (Java 25+), the SNI
        routing bypass via fragmented ClientHello, CVE-2026-59902 (transport-sctp)
        and CVE-2026-59903 (codec-http CORS Vary).
        NEXUS-54004: Upgrade netty-bom to 4.2.16.Final to resolve CVE-2026-56819
        (netty-codec-http2 memory leak in the HTTP/2 decompressor - CWE-401,
        CVSS 7.5, GHSA-93wv-jw9v-4972).
        NEXUS-53122: Upgrade netty-bom to 4.2.15.Final to resolve CVE-2026-42587
        (codec-http/http2 decompression limit bypass - CVSS 8.7). The earlier
        4.2.14.Final upgrade addressed the following CVEs but not 42587:
        - CVE-2026-42577 (epoll transport DoS - CVSS 8.7)
        - CVE-2026-42578 (handler-proxy HTTP header injection - CVSS 7.5)
        - CVE-2026-42579 (codec-dns domain name validation - CVSS 7.5)
        - CVE-2026-42580, 42581, 42584, 42585, 41417 (codec-http request smuggling - CVSS 5.3-8.7)
        - CVE-2026-42583 (codec-compression memory allocation DoS - CVSS 7.5)
      -->
      <dependency>
        <groupId>io.netty</groupId>
        <artifactId>netty-bom</artifactId>
        <version>4.2.18.Final</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>

      <!--
        Keep reactor-bom at 2025.0.7 or later so reactor-netty stays at 1.3.7+. Earlier
        release trains ship reactor-netty 1.3.6, which carries four Security-Medium CVEs and
        reaches the distribution transitively through
        nexus-blobstore-azure-cloud -> azure-core-http-netty:
        - CVE-2026-47874 (reactor-netty-http, CVSS 6.9) unbounded pipelined-request queue in
          HttpTrafficHandler.doPipeline - memory-exhaustion DoS
        - CVE-2026-47845 (reactor-netty-http, CVSS 6.3) HAProxy protocol loses the real client
          IP after the first request on a reused connection - IP ACL / rate-limit bypass
        - CVE-2026-47848 (reactor-netty-http, CVSS 6.0) WebSocket handshake skips cross-origin
          redirect header stripping - Authorization / Cookie leak
        - CVE-2026-47843 (reactor-netty-core, CVSS 6.3) NameResolverProvider equals/hashCode
          omit hostsFileEntriesResolver - DNS resolver reused across differing client configs
        2025.0.7 also carries reactor-core 3.8.7. The root pom pins reactor-core explicitly
        and that pin wins over this import, so the two must stay in step: any future bump here
        must not drop reactor-core below the version pinned in the root pom.
      -->
      <dependency>
        <groupId>io.projectreactor</groupId>
        <artifactId>reactor-bom</artifactId>
        <version>2025.0.7</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>

      <!-- NEXUS-55141: manage the SDK's shaded jackson-core explicitly. It is never declared
           directly, only pulled in behind the artifacts below, so without an entry here its
           version floor is left to nearest-wins mediation (see property above). -->
      <dependency>
        <groupId>software.amazon.awssdk</groupId>
        <artifactId>third-party-jackson-core</artifactId>
        <version>${aws-java-sdk.version}</version>
      </dependency>

